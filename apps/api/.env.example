# Hono API (tsx loads this file from apps/api/.env).
# Placeholders only — copy to .env locally. Never commit real keys.
# See docs/supabase-setup.md. Blank/placeholder values = in-memory mock.

PORT=8787
AJAX_TENANT_SLUG=ajax
AJAX_MOCK_SECRET=dev-only-change-me

# Live path: Supabase project name ajax-training-app
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used to flip runtimeMode to live. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-SERVER-ONLY-never-commit

# Optional. When set, Pace / Dave can create/assign (including POST /coach/assign-from-intake)
# and mint demo member sessions (POST /auth/coach-session) with header X-Coach-Key.
# Never commit a real key.
# COACH_API_KEY=

# Live Postgres TLS. Unset = auto-detect Supabase / pooler hosts
# (ssl: { rejectUnauthorized: false }). Set 0 for local Postgres without TLS.
# DATABASE_SSL=

# Optional comma-separated extra browser origins. Unset stays permissive.
# Typical Expo web / LAN / expo.dev / vercel.app / ajaxgym.com are always allowed.
# CORS_ORIGINS=
