# Expo app (loads apps/mobile/.env). Placeholders only — never commit real keys.
# app.config.js reads these into extra. See docs/go-live.md and docs/supabase-setup.md.
#
# Local (default): mock API on this machine
#   EXPO_PUBLIC_API_URL=http://localhost:8787
#   EXPO_PUBLIC_USE_MOCK=1
# Live device / Expo web against the deployed API + ajax-training-app:
#   EXPO_PUBLIC_API_URL=https://YOUR-VERCEL-APP.vercel.app
#   EXPO_PUBLIC_USE_MOCK=0
#   EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_USE_MOCK=1

# Same ajax-training-app project as the API. Public URL + anon only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Do not add SUPABASE_SERVICE_ROLE_KEY here. It is server-only.

# Optional local-only demo button on LoginScreen. Same value as API COACH_API_KEY.
# Never commit a real key. Prefer the curl in docs/go-live.md ("Demo the app").
# EXPO_PUBLIC_DEMO_COACH_KEY=
