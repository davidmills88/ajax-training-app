# Expo app (loads apps/mobile/.env). Placeholders only — never commit real keys.
# See docs/supabase-setup.md. EXPO_PUBLIC_USE_MOCK=1 keeps the local API mock.

EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_USE_MOCK=1

# Same ajax-training-app project as the API. Public URL + anon only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Do not add SUPABASE_SERVICE_ROLE_KEY here. It is server-only.
