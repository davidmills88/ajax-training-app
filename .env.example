# Copy values into apps/api/.env and apps/mobile/.env (see docs/supabase-setup.md).
# Placeholders only — never put live keys in git. M0 still runs on the in-memory mock
# if these stay as written.

# --- Intended production owners (create later; not required for M0) ---
# GitHub:           davidmills88 / Ajax Fitness owner
# Supabase:         same Ajax Fitness owner — project name: ajax-training-app
# API host:         Vercel or Fly, same owner
# Apple Developer:  david@ajaxgym.com  (Sign in with Apple + TestFlight — later)
# Expo / EAS:       david@ajaxgym.com  (iOS builds — later)

# API — placeholder Supabase/DB values keep mock mode
PORT=8787
AJAX_TENANT_SLUG=ajax
AJAX_MOCK_SECRET=dev-only-change-me

# Optional live path (Supabase Auth + Postgres). Project: ajax-training-app
# Leave as placeholders until the owner project exists. App still boots if unset.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never ship to Expo / the browser. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-SERVER-ONLY-never-commit
# Optional coach/service header for POST /coach/blocks (Pace). Not required in mock mode.
# COACH_API_KEY=

# Optional API deploy hints (fill when the owner project exists)
# VERCEL_PROJECT=
# FLY_APP=

# Mobile — defaults to the local API mock when EXPO_PUBLIC_USE_MOCK=1
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_USE_MOCK=1
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# No Next.js app in this repo. If one is added later, use the same project URL/anon:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Expo / EAS — leave unset until the david@ajaxgym.com Expo org exists
# EXPO_OWNER=ajaxfitness
# EAS_PROJECT_ID=
