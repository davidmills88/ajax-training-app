# Copy to .env locally. Leave secrets empty — M0 runs on the in-memory mock.
# Do not commit live keys. Lily owns e2e decisions; David logins / billing come later.

# --- Intended production owners (create later; not required for M0) ---
# GitHub:           davidmills88 / Ajax Fitness owner
# Supabase:         same Ajax Fitness owner (Auth + Postgres)
# API host:         Vercel or Fly, same owner
# Apple Developer:  david@ajaxgym.com  (Sign in with Apple + TestFlight — later)
# Expo / EAS:       david@ajaxgym.com  (iOS builds — later)

# API — blank Supabase/DB values = mock mode
PORT=8787
AJAX_TENANT_SLUG=ajax
AJAX_MOCK_SECRET=dev-only-change-me

# Optional live path (Supabase Auth + Postgres under the Ajax owner).
# App still boots if these are missing.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional API deploy hints (fill when the owner project exists)
# VERCEL_PROJECT=
# FLY_APP=

# Mobile — defaults to the local API mock when unset
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_USE_MOCK=1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Expo / EAS — leave unset until the david@ajaxgym.com Expo org exists
# EXPO_OWNER=ajaxfitness
# EAS_PROJECT_ID=
