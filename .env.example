# API — leave blank to run the in-memory mock (no live credentials required)
PORT=8787
AJAX_TENANT_SLUG=ajax
AJAX_MOCK_SECRET=dev-only-change-me

# Optional live path (Supabase Auth + Postgres). App still boots if these are missing.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile — defaults to the local API mock when unset
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_USE_MOCK=1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
