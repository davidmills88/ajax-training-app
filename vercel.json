{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm run build -w @ajax/shared",
  "buildCommand": null,
  "outputDirectory": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{apps/api/**,packages/shared/package.json,packages/shared/dist/**,packages/shared/src/**}"
    }
  }
}
